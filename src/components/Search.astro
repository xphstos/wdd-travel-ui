---
import SearchAlt from "./icons/search-alt.astro"
---

<section class="px-4">
    <div class="inset-ring-2 ring-current p-4 rounded-md flex items-center justify-between">
        <input class="flex-1 focus:outline-none placeholder:text-current" role="search" type="text" name="search" placeholder="Have some topics to cover?">
        <button class="aspect-square rounded-md cursor-pointer">
            <SearchAlt class="size-6" />
        </button>
    </div>
</section>